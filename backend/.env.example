PORT=5000
# Leave MONGO_URL empty for the sample catalog and simulated checkout.
MONGO_URL=
# Required with MongoDB: generate with node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# For production, set NODE_ENV=production and serve behind HTTPS.
NODE_ENV=development
EMAIL_USER=
EMAIL_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=